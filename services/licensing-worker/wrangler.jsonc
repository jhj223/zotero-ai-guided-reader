{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zotero-ai-guided-reader-licensing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zotero-ai-guided-reader-licensing",
      "database_id": "8262d84a-3305-4978-b6c8-3c9f36c1498f",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
