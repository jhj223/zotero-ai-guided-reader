NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://license.example.com
SOURCE_URL=https://github.com/jhj223/zotero-ai-guided-reader
DATABASE_PATH=/var/lib/zotero-ai-guided-reader/licensing.sqlite

ENTITLEMENT_ISSUER=https://license.example.com
ENTITLEMENT_AUDIENCE=zotero-ai-guided-reader
ENTITLEMENT_KEY_ID=license-key-2026
LICENSE_PRIVATE_KEY_PATH=/run/secrets/license-private.pem
LICENSE_PUBLIC_KEY_PATH=/run/secrets/license-public.pem

MONTHLY_PRICE_FEN=1990
YEARLY_PRICE_FEN=19900
PAYMENT_PROVIDER=wechat-native

# PAYMENT_PROVIDER=chinaums-qr 时启用以下银联商务开放平台参数：
# CHINAUMS_APP_ID=
# CHINAUMS_APP_KEY=
# CHINAUMS_MID=
# CHINAUMS_TID=
# CHINAUMS_MSG_SRC_ID=
# CHINAUMS_NOTIFY_KEY=

# PAYMENT_PROVIDER=wechat-static-qr 时启用以下两项，并将文件放在 Git 之外：
# WECHAT_STATIC_QR_IMAGE_PATH=/run/secrets/wechat-static-qr.png
# RECEIPT_WATCHER_KEYS_JSON={"merchant-pc-01":"/run/secrets/merchant-pc-01.pub.pem"}

# PAYMENT_PROVIDER=wechat-native 时启用以下微信 APIv3 配置：
WECHAT_MERCHANT_ID=
WECHAT_APP_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/wechat-merchant-private.pem
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_KEYS_JSON={"platform-serial":"/run/secrets/wechat-platform-public.pem"}
