{
  "name": "zotero-ai-guided-reader",
  "type": "module",
  "version": "0.1.3",
  "description": "Zotero 9 AI 论文带读：MinerU 解析、证据回跳、图表索引、笔记与 Anki 导出",
  "config": {
    "addonName": "Zotero AI 带读",
    "addonID": "zotero-ai-guided-reader@jhj223",
    "addonRef": "zoteroaiguidedreader",
    "addonInstance": "ZoteroAIGuidedReader",
    "prefsPrefix": "extensions.zotero.zoteroaiguidedreader"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhj223/zotero-ai-guided-reader.git"
  },
  "author": "jhj223",
  "bugs": {
    "url": "https://github.com/jhj223/zotero-ai-guided-reader/issues"
  },
  "homepage": "https://github.com/jhj223/zotero-ai-guided-reader#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:zotero": "zotero-plugin test",
    "legacy-license:dev": "npm --prefix services/licensing run dev",
    "legacy-license:test": "npm --prefix services/licensing test",
    "legacy-license:build": "npm --prefix services/licensing run build",
    "license:worker:test": "npm --prefix services/licensing-worker test",
    "license:worker:typecheck": "npm --prefix services/licensing-worker run typecheck",
    "license:worker:types": "npm --prefix services/licensing-worker run types",
    "license:worker:migrate:local": "npm --prefix services/licensing-worker run db:migrate:local",
    "license:worker:migrate:remote": "npm --prefix services/licensing-worker run db:migrate:remote",
    "license:worker:dry-run": "npm --prefix services/licensing-worker run dry-run",
    "license:worker:deploy": "npm --prefix services/licensing-worker run deploy",
    "afdian:relay:test": "npm --prefix services/afdian-webhook-relay test",
    "license:keys": "node scripts/generate-license-keys.mjs",
    "licenses:audit": "node scripts/audit-runtime-licenses.mjs",
    "commercial:check": "node scripts/assert-commercial-release-ready.mjs",
    "release:sbom": "node scripts/create-release-sbom.mjs",
    "release:checksums": "node scripts/create-release-checksums.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "eslint": "^10.0.3",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.0-beta.4"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
