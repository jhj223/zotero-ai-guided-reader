pref-title = Zotero AI Guided Reader
pref-enable =
    .label = Enable guided reading sidebar
pref-license-section = License and subscription
pref-license-help = Monthly and yearly plans renew manually and never auto-charge. The plugin refreshes and unlocks Pro after payment is confirmed.
pref-llm-section = Guided reading LLM
pref-llm-provider = Provider
pref-llm-key = LLM API Key
pref-llm-model = Model
pref-fetch-models = Fetch models
pref-llm-custom-model = Custom model name
pref-llm-base-url = Base URL
pref-validate-llm = Validate model connection
pref-cli-help = Local CLI providers use the Codex or Claude Code login on this computer. No LLM key is required; the plugin runs them read-only without tools or session persistence.
pref-mineru-section = MinerU precise parsing
pref-mineru-key = MinerU API Key
pref-mineru-model = MinerU model
pref-mineru-model-vlm = vlm (recommended)
pref-mineru-model-auto = Auto (inspect PDF text layer)
pref-mineru-language = Document language
pref-mineru-ocr = Force OCR
pref-mineru-ocr-always = Force OCR on
pref-mineru-ocr-never = Do not force OCR
pref-validate-mineru = Validate MinerU key
pref-mineru-quota = MinerU precise parsing supports files up to 200MB / 200 pages. Each account receives 1000 highest-priority pages per day; excess pages may queue longer.
pref-semantic-section = Optional semantic location fallback
pref-semantic-provider = Provider
pref-semantic-key = API Key
pref-semantic-model = Embedding model
pref-semantic-base-url = Base URL
pref-validate-semantic = Validate semantic locator
pref-semantic-help = Disabled by default. Nearby source candidates are sent only after verbatim and fuzzy matching fail, allowing paraphrased claims to recover their source location. API keys are never logged.
pref-temporary-highlight =
    .label = Keep the matching text or region highlighted after navigation
pref-help = { $name } Build { $version } { $time }
